/* Backup/alternate stylesheet (no glassmorphism — solid surfaces) */
:root{--sky-500:#0EA5E9;--sky-600:#0284C7;--text-primary:#1E293B;--text-secondary:#475569;
--border:#E2E8F0;--radius:14px;--sidebar-w:260px;--shadow-card:0 2px 16px rgba(14,165,233,.06)}
body{margin:0;font-family:Inter,system-ui,sans-serif;background:#F0F4F8;color:var(--text-primary)}
.sidebar{position:fixed;inset:0 auto 0 0;width:var(--sidebar-w);background:linear-gradient(160deg,#0EA5E9,#0277BD 50%,#01579B);color:#fff;padding:20px}
.page-content{margin-left:var(--sidebar-w);padding:24px}
.card{background:#fff;border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-card)}
.btn-primary{background:linear-gradient(135deg,#38BDF8,#0284C7);color:#fff;border:0;border-radius:10px;padding:10px 18px;cursor:pointer}
.table{width:100%;border-collapse:collapse}.table th,.table td{padding:12px;border-bottom:1px solid var(--border);text-align:left}
